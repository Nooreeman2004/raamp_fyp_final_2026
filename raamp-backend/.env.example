# ============================================================
# RAAMP Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ============================================================

# ── Database ─────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/raamp_db

# ── App ──────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000/api
JWT_SECRET_KEY=change-me-in-production
# Access token lifetime (days). Must match cookie max_age expectations for SPA + refresh.
JWT_EXPIRATION_DAYS=7
# Set to production so global 500 responses omit exception details (see main.py exception handler).
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Extra allowed browser origins for CORS (comma-separated). FRONTEND_URL is merged automatically.
# Example: CORS_ALLOW_ORIGINS=https://app.example.com,https://preview.vercel.app
# CORS_ALLOW_ORIGINS=

# ── Google Maps ──────────────────────────────────────────────
# Required by Geo-Intent engine (Places Nearby API)
GOOGLE_MAPS_API_KEY=

# ── Geo-Intent Marketing Engine ──────────────────────────────
# Tomorrow.io Weather API  (https://app.tomorrow.io/)
# REQUIRED: without this key, weather signals fall back to neutral (0.5)
TOMORROW_API_KEY=

# ISO 3166-1 alpha-2 geo scope for Google Trends (e.g. PK, US, GB, "" = global)
GOOGLE_TRENDS_GEO=PK

# Geo-intent heat-score: max wall-clock seconds for Trends (SerpAPI/pytrends). Prevents blocking past frontend timeout. Default 12; clamped 3–25.
# RAAMP_GEO_TRENDS_TIMEOUT_SEC=12

# Multi-zone recommender (POST /recommend-zones): compass points on the ring (clamped 4–8 in code).
# Each point runs a full parallel ingest_all_signals — lower this to reduce external API bursts and latency.
RAAMP_ZONE_NUM_POINTS=4

# SerpAPI — Google SERP / optional integrations (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# Trends data provider (auto|serpapi|pytrends)
# - auto: use SerpAPI when configured, else pytrends
# - serpapi: force SerpAPI and fall back to pytrends on transient errors/quota
# - pytrends: force pytrends only
TRENDS_PROVIDER=auto

# Trend detection parameters (optional; defaults match existing behavior)
TREND_Z_THRESHOLD=2.0
TREND_ROLLING_WINDOW_DAYS=14
TREND_EWMA_ALPHA=0.3
TREND_MIN_DATA_POINTS=5

# ── Encryption ───────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=
FIREBASE_PROJECT_ID=

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini

# ── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY=

# ── Facebook OAuth ───────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/profile/onboarding/facebook/callback

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mailtrap ─────────────────────────────────────────────────
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_API_TOKEN=
MAIL_FROM=hello@yourapp.com
MAIL_FROM_NAME=RAAMP Team
EMAIL_METHOD=smtp

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PRO_PRODUCT_ID=prod_xxx
PREMIUM_PRODUCT_ID=prod_xxx
PRO_PRICE_ID=price_xxx
PREMIUM_PRICE_ID=price_xxx

# ── Pinecone ─────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=raamp

# ── RAG ──────────────────────────────────────────────────────
VECTOR_STORE_PATH=data/vector_store_data
EMBEDDINGS_PATH=data/embeddings_data
DEFAULT_N_RESULTS=5
SIMILARITY_THRESHOLD=0.3
