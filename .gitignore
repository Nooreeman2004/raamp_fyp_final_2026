# Root level .gitignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment variables
**/*.env
**/*.env.local
**/*.env.*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

# Build outputs (if any at root)
dist/
build/
*.egg-info/

# Dependencies
node_modules/
.venv/
venv/
env/

# Python artifacts
**/__pycache__/
*.py[cod]
*$py.class

# Firebase service account (sensitive)
firebase-service-account.json
**/*-service-account.json
*.json.key

# Agentic / AI
.gemini/
.agent/
brain/

